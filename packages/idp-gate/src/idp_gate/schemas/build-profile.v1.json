{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/suyashkunte/idp-platform/schemas/build-profile.v1.json",
  "title": "IDP build profile (profile.yaml) v1",
  "description": "A language toolchain profile for the Intelligent Delivery Pipeline. See docs/adr/0012-build-profiles.md.",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Must equal the profile's directory name"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "setup": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "run": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["name", "run"],
        "additionalProperties": false
      }
    },
    "defaultTargets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "coverage": {
      "type": "object",
      "properties": {
        "format": {
          "enum": ["cobertura", "lcov", "jacoco"]
        }
      },
      "required": ["format"],
      "additionalProperties": false
    },
    "sbom": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "format": {
          "enum": ["cyclonedx-json"]
        }
      },
      "required": ["tool", "format"],
      "additionalProperties": false
    },
    "sca": {
      "type": "object",
      "properties": {
        "tool": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["tool"],
      "additionalProperties": false
    }
  },
  "required": ["name", "description", "setup", "defaultTargets", "coverage", "sbom", "sca"],
  "additionalProperties": false
}
